    <script is:inline>
        // Todo el JavaScript original intacto para garantizar funcionalidad idéntica
        const parallaxBg = document.getElementById('parallaxBg');
        let ticking = false;
        function updateParallax() {
            const scrolled = window.pageYOffset;
            const rate = scrolled * 0.4;
            if (parallaxBg) {
                parallaxBg.style.transform = `translateY(${rate}px) scale(1.05)`;
            }
            ticking = false;
        }
        window.addEventListener('scroll', function() {
            if (!ticking) { 
                window.requestAnimationFrame(updateParallax); 
                ticking = true; 
            }
        });

        function toggleMenu() { 
            document.getElementById('mobileMenu').classList.toggle('hidden'); 
        }

        function handleQuote(e) {
            e.preventDefault();
            const form = e.target;
            const tipo = form.querySelector('select').value;
            const inputs = form.querySelectorAll('input');
            const message = `Hola ST TRANSAE! Quiero cotizar:%0A%0A Tipo: ${tipo}%0A📍 Origen: ${inputs[0].value}%0A🎯 Destino: ${inputs[1].value}%0A Fecha: ${inputs[2].value}%0A⏰ Hora: ${inputs[3].value}`;
            window.open(`https://wa.me/56989625825?text=${message}`, '_blank');
        }

        function toggleServices(btn) {
            const wrap = document.getElementById('moreServices');
            const open = wrap.dataset.open === 'true';
            if (open) {
                wrap.style.gridTemplateRows = '0fr';
                wrap.dataset.open = 'false';
                btn.textContent = 'VER MÁS';
            } else {
                wrap.style.gridTemplateRows = '1fr';
                wrap.dataset.open = 'true';
                btn.textContent = 'VER MENOS';
                setTimeout(() => {
                    document.getElementById('servicesExpanded').scrollIntoView({ behavior: 'smooth', block: 'start' });
                }, 400);
            }
        }

        function toggleFaq(button) {
            const item = button.parentElement;
            const content = item.querySelector('.faq-content');
            const buttonCircle = item.querySelector('.faq-button');
            const icon = item.querySelector('.faq-icon');
            const isActive = item.classList.contains('active');
            document.querySelectorAll('.faq-item.active').forEach(activeItem => {
                if (activeItem !== item) {
                    activeItem.classList.remove('active');
                    const activeContent = activeItem.querySelector('.faq-content');
                    const activeButton = activeItem.querySelector('.faq-button');
                    const activeIcon = activeItem.querySelector('.faq-icon');
                    activeContent.classList.remove('grid-rows-[1fr]');
                    activeContent.classList.add('grid-rows-[0fr]');
                    if (activeButton) { activeButton.classList.remove('blue'); activeButton.classList.add('black'); }
                    if (activeIcon) activeIcon.classList.remove('rotate-45');
                }
            });
            if (isActive) {
                item.classList.remove('active');
                content.classList.remove('grid-rows-[1fr]');
                content.classList.add('grid-rows-[0fr]');
                buttonCircle.classList.remove('blue');
                buttonCircle.classList.add('black');
                if (icon) icon.classList.remove('rotate-45');
            } else {
                item.classList.add('active');
                content.classList.remove('grid-rows-[0fr]');
                content.classList.add('grid-rows-[1fr]');
                buttonCircle.classList.remove('black');
                buttonCircle.classList.add('blue');
                if (icon) icon.classList.add('rotate-45');
            }
        }

        function updateClock() {
            const now = new Date();
            const santiagoTime = new Date(now.toLocaleString('en-US', { timeZone: 'America/Santiago' }));
            const h = String(santiagoTime.getHours()).padStart(2, '0');
            const m = String(santiagoTime.getMinutes()).padStart(2, '0');
            const s = String(santiagoTime.getSeconds()).padStart(2, '0');
            const timeEl = document.getElementById('liveTime');
            if (timeEl) timeEl.textContent = `${h}:${m}:${s}`;
        }
        setInterval(updateClock, 1000); 
        updateClock();

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => { if (entry.isIntersecting) entry.target.classList.add('visible'); });
        }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });
        document.querySelectorAll('.scroll-reveal').forEach(el => observer.observe(el));

        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            });
        });

        function handleContactEmail(e) {
            e.preventDefault();
            const form = e.target;
            const nombre = form.querySelector('input[name="nombre"]').value;
            const telefono = form.querySelector('input[name="telefono"]').value;
            const email = form.querySelector('input[name="email"]').value;
            const subject = encodeURIComponent(`Nuevo mensaje de contacto de ${nombre}`);
            const body = encodeURIComponent(`Nombre: ${nombre}\nTeléfono: ${telefono}\nEmail: ${email}`);
            window.location.href = `mailto:paulahansen23@gmail.com?subject=${subject}&body=${body}`;
        }
    </script>
