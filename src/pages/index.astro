        if (heroSection) {
            heroSection.addEventListener('mousemove', function(e) {
                const x = (e.clientX / window.innerWidth - 0.5) * 20;
                const y = (e.clientY / window.innerHeight - 0.5) * 20;
                const far = document.getElementById('bokehFar');
                const mid = document.getElementById('bokehMid');
                if (far) far.style.transform = `translate(${x * 0.5}px, ${y * 0.5}px)`;
                if (mid) mid.style.transform = `translate(${x * 1}px, ${y * 1}px)`;
            });
        }

        function toggleMenu() { document.getElementById('mobileMenu').classList.toggle('hidden'); }

        function handleQuote(e) {
            e.preventDefault();
            const form = e.target;
            const tipo = form.querySelector('select').value;
            const inputs = form.querySelectorAll('input');
            const selects = form.querySelectorAll('select');
            const message = `Hola ST TRANSAE! Quiero cotizar:%0A%0A Tipo: ${tipo}%0A📍 Origen: ${inputs[0].value}%0A🎯 Destino: ${inputs[1].value}%0A📅 Fecha: ${inputs[2].value}%0A⏰ Hora: ${inputs[3].value}%0A👥 Pasajeros: ${selects[1].value}`;
            window.open(`https://wa.me/56989625825?text=${message}`, '_blank');
        }

        function filterServices(category, btn) {
            document.querySelectorAll('.filter-btn').forEach(b => {
                b.classList.remove('bg-damasco-800', 'text-white');
                b.classList.add('bg-gray-100', 'text-gray-700');
            });
            btn.classList.remove('bg-gray-100', 'text-gray-700');
            btn.classList.add('bg-damasco-800', 'text-white');
            const cards = document.querySelectorAll('#servicesGrid .service-card');
            cards.forEach(card => {
                if (category === 'all' || card.dataset.category === category) {
                    card.style.display = 'block';
                    card.style.animation = 'fadeIn 0.5s ease-out';
                } else { card.style.display = 'none'; }
            });
        }

        function updateClock() {
            const now = new Date();
            const santiagoTime = new Date(now.toLocaleString('en-US', { timeZone: 'America/Santiago' }));
            const h = String(santiagoTime.getHours()).padStart(2, '0');
            const m = String(santiagoTime.getMinutes()).padStart(2, '0');
            const s = String(santiagoTime.getSeconds()).padStart(2, '0');
            document.getElementById('liveTime').textContent = `${h}:${m}:${s}`;
        }
        setInterval(updateClock, 1000); updateClock();

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => { if (entry.isIntersecting) entry.target.classList.add('visible'); });
        }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });
        document.querySelectorAll('.scroll-reveal').forEach(el => observer.observe(el));

        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            });
        });
    </script>
</body>

</html>
