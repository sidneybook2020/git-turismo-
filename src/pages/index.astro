---
import '../styles/global.css';
// Component Imports
import Button from '../components/Button.astro';

// Full Astro Component Syntax:
// https://docs.astro.build/basics/astro-components/
---

<html lang="en">
	<!DOCTYPE html>

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ST TRANSAE | Transporte Privado Ejecutivo Chile</title>
    <meta name="description" content="Servicio de transporte privado ejecutivo en Santiago de Chile. Traslados aeropuerto, tours vitivinícolas, eventos. Disponible 24/7.">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        damasco: {
                            50: '#fdf2f2', 100: '#fce5e5', 200: '#f9c8c8', 300: '#f49d9d',
                            400: '#ec6d6d', 500: '#e04545', 600: '#c92a2a', 700: '#a82020',
                            800: '#8B1A1A', 900: '#6b1515',
                        },
                        navy: {
                            50: '#f0f4f8', 100: '#d9e2ec', 200: '#bcccdc', 300: '#9fb3c8',
                            400: '#829ab1', 500: '#627d98', 600: '#486581', 700: '#334e68',
                            800: '#243b53', 900: '#102a43', 950: '#0a1628',
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        display: ['Bebas Neue', 'sans-serif'],
                    },
                    animation: {
                        'fade-in': 'fadeIn 0.8s ease-out',
                        'slide-up': 'slideUp 0.8s ease-out',
                        'float': 'float 3s ease-in-out infinite',
                    },
                    keyframes: {
                        fadeIn: { '0%': { opacity: '0' }, '100%': { opacity: '1' } },
                        slideUp: { '0%': { opacity: '0', transform: 'translateY(30px)' }, '100%': { opacity: '1', transform: 'translateY(0)' } },
                        float: { '0%, 100%': { transform: 'translateY(0)' }, '50%': { transform: 'translateY(-10px)' } },
                    }
                }
            }
        }
    </script>
    <style>
        * { scroll-behavior: smooth; }
        body { font-family: 'Inter', sans-serif; }
        .font-display { font-family: 'Bebas Neue', sans-serif; letter-spacing: 0.02em; }

        /* ===== HERO BACKGROUND - Driver Scene ===== */
        .hero-driver-bg {
            position: absolute;
            inset: 0;
            overflow: hidden;
            z-index: 0;
        }
        .hero-driver-bg::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, #0a1628 0%, #1a2d4a 30%, #0f1f35 70%, #050d1a 100%);
        }
        .bokeh-layer { position: absolute; inset: 0; overflow: hidden; }
        .bokeh { position: absolute; border-radius: 50%; filter: blur(1px); opacity: 0.85; }
        .bokeh-soft { filter: blur(15px); opacity: 0.5; }
        .street-light {
            position: absolute; width: 8px; height: 8px; background: #fef3c7; border-radius: 50%;
            box-shadow: 0 0 20px 8px rgba(254, 243, 199, 0.6), 0 0 40px 15px rgba(254, 243, 199, 0.3);
        }
        .dashboard-silhouette {
            position: absolute; bottom: 0; left: 0; right: 0; height: 35%;
            background: linear-gradient(180deg, transparent 0%, #050d1a 40%, #020610 100%);
        }
        .steering-wheel-container {
            position: absolute; bottom: -15%; left: 50%; transform: translateX(-50%);
            width: 550px; height: 550px; opacity: 0.85;
        }
        .driver-hands { position: absolute; bottom: 0; left: 0; right: 0; height: 45%; }
        .parallax-layer { will-change: transform; transition: transform 0.1s linear; }

        .glass-card { background: rgba(255, 255, 255, 0.05); backdrop-filter: blur(20px); border: 1px solid rgba(255, 255, 255, 0.1); }
        .glass-white { background: rgba(255, 255, 255, 0.97); backdrop-filter: blur(20px); }
        .text-gradient {
            background: linear-gradient(135deg, #ffffff 0%, #d9e2ec 100%);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
        }

        .damasco-gradient { background: linear-gradient(135deg, #8B1A1A 0%, #c92a2a 100%); }
        .navy-gradient { background: linear-gradient(135deg, #0a1628 0%, #102a43 100%); }

        .btn-damasco {
            background: #8B1A1A;
            color: white;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(139, 26, 26, 0.4);
        }
        .btn-damasco:hover {
            background: #a82020;
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(139, 26, 26, 0.5);
        }

        .btn-outline-white {
            background: transparent;
            border: 2px solid rgba(255, 255, 255, 0.4);
            color: white;
            transition: all 0.3s ease;
        }
        .btn-outline-white:hover {
            background: rgba(255, 255, 255, 0.1);
            border-color: rgba(255, 255, 255, 0.8);
        }

        .btn-primary {
            background: linear-gradient(135deg, #8B1A1A 0%, #a82020 100%);
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(139, 26, 26, 0.4);
        }
        .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(139, 26, 26, 0.5); }

        .service-card { transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1); }
        .service-card:hover { transform: translateY(-8px); box-shadow: 0 20px 40px rgba(139, 26, 26, 0.15); }
        .indicator-card { transition: all 0.3s ease; }
        .indicator-card:hover { transform: scale(1.05); }
        .feature-icon {
            background: linear-gradient(135deg, #8B1A1A 0%, #c92a2a 100%);
            box-shadow: 0 8px 20px rgba(139, 26, 26, 0.3);
        }
        .scroll-reveal { opacity: 0; transform: translateY(30px); transition: all 0.8s ease-out; }
        .scroll-reveal.visible { opacity: 1; transform: translateY(0); }
        .pulse-dot { animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite; }
        @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }
        .live-indicator::before {
            content: ''; display: inline-block; width: 8px; height: 8px;
            background: #10b981; border-radius: 50%; margin-right: 8px; animation: pulse 2s infinite;
        }
        .dashboard-bg {
            background: radial-gradient(circle at 10% 20%, rgba(139, 26, 26, 0.1) 0%, transparent 40%),
                        radial-gradient(circle at 90% 80%, rgba(30, 41, 59, 0.2) 0%, transparent 40%),
                        linear-gradient(180deg, #0a1628 0%, #102a43 100%);
        }
        .input-field { transition: all 0.3s ease; border: 1px solid #e2e8f0; }
        .input-field:focus { border-color: #8B1A1A; box-shadow: 0 0 0 3px rgba(139, 26, 26, 0.1); outline: none; }
        .nav-link { position: relative; }
        .nav-link::after {
            content: ''; position: absolute; bottom: -4px; left: 0; width: 0; height: 2px;
            background: #8B1A1A; transition: width 0.3s ease;
        }
        .nav-link:hover::after { width: 100%; }
        .payment-icon { transition: all 0.3s ease; }
        .payment-icon:hover { transform: scale(1.1); }
        .whatsapp-btn {
            background: linear-gradient(135deg, #25D366 0%, #128C7E 100%);
            box-shadow: 0 4px 15px rgba(37, 211, 102, 0.4);
        }
        .whatsapp-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(37, 211, 102, 0.5); }
        .section-divider { height: 4px; background: linear-gradient(90deg, transparent 0%, #8B1A1A 50%, transparent 100%); }
        .bmw-car-container {
            position: relative; background: linear-gradient(180deg, #f8fafc 0%, #e2e8f0 100%);
            border-radius: 2rem; overflow: hidden;
        }
        .bmw-car-svg { filter: drop-shadow(0 30px 60px rgba(16, 42, 67, 0.4)); }
        .windshield-frame { position: absolute; inset: 0; pointer-events: none; z-index: 2; }
        .a-pillar-left {
            position: absolute; top: 0; left: 0; width: 18%; height: 100%;
            background: linear-gradient(90deg, #020610 0%, #0a1628 60%, transparent 100%);
            clip-path: polygon(0 0, 100% 0, 60% 100%, 0 100%);
        }
        .a-pillar-right {
            position: absolute; top: 0; right: 0; width: 18%; height: 100%;
            background: linear-gradient(270deg, #020610 0%, #0a1628 60%, transparent 100%);
            clip-path: polygon(100% 0, 0 0, 40% 100%, 100% 100%);
        }
        .rearview-area {
            position: absolute; top: 0; left: 50%; transform: translateX(-50%);
            width: 25%; height: 15%; background: linear-gradient(180deg, #020610 0%, transparent 100%);
        }
        @media (max-width: 768px) {
            .hero-title { font-size: 2.8rem !important; }
            .steering-wheel-container { width: 350px; height: 350px; }
        }
    </style>
</head>
<body class="bg-white text-gray-900 overflow-x-hidden">

    <!-- Top Bar -->
    <div class="bg-navy-950 text-white text-xs py-2 px-4">
        <div class="max-w-7xl mx-auto flex justify-between items-center">
            <div class="flex items-center gap-4">
                <span class="flex items-center gap-1">
                    <span class="w-2 h-2 bg-green-400 rounded-full pulse-dot"></span>
                    DISPONIBLE 24/7
                </span>
                <span class="hidden md:inline">•</span>
                <span class="hidden md:inline">ENGLISH SPOKEN</span>
                <span class="hidden md:inline">•</span>
                <span class="hidden md:inline">LICENCIA M.T.T. #14457</span>
            </div>
            <div class="flex items-center gap-3">
                <button class="text-gray-400 hover:text-white transition">ES</button>
                <span class="text-gray-600">|</span>
                <button class="text-white font-medium">EN</button>
            </div>
        </div>
    </div>

    <!-- Header -->
    <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-gray-100 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 py-4">
            <div class="flex justify-between items-center">
                <div class="flex items-center gap-3">
                    <div class="w-12 h-12 rounded-full damasco-gradient flex items-center justify-center shadow-lg">
                        <span class="text-white font-bold text-lg font-display">ST</span>
                    </div>
                    <div>
                        <h1 class="text-xl font-bold text-navy-950 tracking-tight font-display">ST TRANSAE</h1>
                        <p class="text-xs text-gray-500 -mt-1">Private Transport & Chauffeur Chile</p>
                    </div>
                </div>
                <nav class="hidden lg:flex items-center gap-8">
                    <a href="#servicios" class="nav-link text-sm font-medium text-gray-700 hover:text-damasco-800 transition">SERVICIOS</a>
                    <a href="#vehiculo" class="nav-link text-sm font-medium text-gray-700 hover:text-damasco-800 transition">VEHÍCULO</a>
                    <a href="#info" class="nav-link text-sm font-medium text-gray-700 hover:text-damasco-800 transition">INFO VIAJERO</a>
                    <a href="#pagos" class="nav-link text-sm font-medium text-gray-700 hover:text-damasco-800 transition">PAGOS</a>
                    <a href="#contacto" class="nav-link text-sm font-medium text-gray-700 hover:text-damasco-800 transition">CONTACTO</a>
                </nav>
                <div class="flex items-center gap-4">
                    <a href="#cotizar" class="hidden md:inline-flex btn-primary text-white px-6 py-2.5 rounded-full text-sm font-semibold">RESERVAR</a>
                    <button class="lg:hidden text-gray-700" onclick="toggleMenu()">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
                    </button>
                </div>
            </div>
        </div>
        <div id="mobileMenu" class="hidden lg:hidden bg-white border-t border-gray-100">
            <div class="px-4 py-4 space-y-3">
                <a href="#servicios" class="block text-gray-700 py-2">SERVICIOS</a>
                <a href="#vehiculo" class="block text-gray-700 py-2">VEHÍCULO</a>
                <a href="#info" class="block text-gray-700 py-2">INFO VIAJERO</a>
                <a href="#pagos" class="block text-gray-700 py-2">PAGOS</a>
                <a href="#contacto" class="block text-gray-700 py-2">CONTACTO</a>
                <a href="#cotizar" class="block btn-primary text-white text-center py-3 rounded-full font-semibold mt-4">RESERVAR AHORA</a>
            </div>
        </div>
    </header>

    <!-- Hero Section -->
    <section class="relative min-h-screen flex items-center overflow-hidden">
        <div class="hero-driver-bg" id="parallaxBg">
            <div class="bokeh-layer" id="bokehFar">
                <div class="bokeh bokeh-soft" style="width:180px;height:180px;background:#fef3c7;top:15%;left:20%;"></div>
                <div class="bokeh bokeh-soft" style="width:140px;height:140px;background:#fbbf24;top:25%;left:45%;"></div>
                <div class="bokeh bokeh-soft" style="width:160px;height:160px;background:#fde68a;top:10%;left:65%;"></div>
                <div class="bokeh bokeh-soft" style="width:120px;height:120px;background:#fef3c7;top:30%;left:80%;"></div>
                <div class="bokeh bokeh-soft" style="width:200px;height:200px;background:#fbbf24;top:20%;left:5%;"></div>
                <div class="bokeh bokeh-soft" style="width:100px;height:100px;background:#fde68a;top:35%;left:35%;"></div>
                <div class="bokeh bokeh-soft" style="width:130px;height:130px;background:#fef3c7;top:18%;left:55%;"></div>
                <div class="bokeh bokeh-soft" style="width:150px;height:150px;background:#fbbf24;top:28%;left:72%;"></div>
            </div>
            <div class="bokeh-layer" id="bokehMid">
                <div class="bokeh" style="width:40px;height:40px;background:#fef3c7;top:20%;left:25%;box-shadow:0 0 30px 10px rgba(254,243,199,0.7);"></div>
                <div class="bokeh" style="width:35px;height:35px;background:#fbbf24;top:28%;left:42%;box-shadow:0 0 25px 8px rgba(251,191,36,0.7);"></div>
                <div class="bokeh" style="width:45px;height:45px;background:#fef3c7;top:15%;left:58%;box-shadow:0 0 35px 12px rgba(254,243,199,0.7);"></div>
                <div class="bokeh" style="width:30px;height:30px;background:#fde68a;top:32%;left:75%;box-shadow:0 0 20px 6px rgba(253,230,138,0.7);"></div>
                <div class="bokeh" style="width:38px;height:38px;background:#fef3c7;top:22%;left:15%;box-shadow:0 0 28px 9px rgba(254,243,199,0.7);"></div>
                <div class="bokeh" style="width:42px;height:42px;background:#fbbf24;top:26%;left:50%;box-shadow:0 0 32px 11px rgba(251,191,36,0.7);"></div>
                <div class="bokeh" style="width:36px;height:36px;background:#fef3c7;top:18%;left:68%;box-shadow:0 0 26px 8px rgba(254,243,199,0.7);"></div>
                <div class="bokeh" style="width:28px;height:28px;background:#fde68a;top:35%;left:30%;box-shadow:0 0 18px 5px rgba(253,230,138,0.7);"></div>
                <div class="bokeh" style="width:25px;height:25px;background:#ef4444;top:30%;left:85%;box-shadow:0 0 20px 6px rgba(239,68,68,0.6);"></div>
                <div class="bokeh" style="width:22px;height:22px;background:#dc2626;top:33%;left:88%;box-shadow:0 0 18px 5px rgba(220,38,38,0.6);"></div>
                <div class="bokeh" style="width:30px;height:30px;background:#ffffff;top:38%;left:12%;box-shadow:0 0 25px 8px rgba(255,255,255,0.5);"></div>
                <div class="bokeh" style="width:28px;height:28px;background:#f0f9ff;top:40%;left:8%;box-shadow:0 0 22px 7px rgba(240,249,255,0.5);"></div>
            </div>
            <div class="bokeh-layer">
                <div class="street-light" style="top:12%;left:22%;"></div>
                <div class="street-light" style="top:18%;left:48%;"></div>
                <div class="street-light" style="top:14%;left:62%;"></div>
                <div class="street-light" style="top:20%;left:78%;"></div>
                <div class="street-light" style="top:16%;left:35%;"></div>
                <div class="street-light" style="top:22%;left:90%;"></div>
            </div>
            <div class="windshield-frame">
                <div class="a-pillar-left"></div>
                <div class="a-pillar-right"></div>
                <div class="rearview-area"></div>
            </div>
            <svg class="steering-wheel-container" viewBox="0 0 400 400" fill="none">
                <circle cx="200" cy="200" r="170" stroke="#1a1a1a" stroke-width="28" fill="none"/>
                <circle cx="200" cy="200" r="170" stroke="#2d2d2d" stroke-width="24" fill="none"/>
                <circle cx="200" cy="200" r="170" stroke="#1a1a1a" stroke-width="20" fill="none"/>
                <circle cx="200" cy="200" r="145" stroke="#0f0f0f" stroke-width="4" fill="none" opacity="0.5"/>
                <circle cx="200" cy="200" r="55" fill="#1a1a1a"/>
                <circle cx="200" cy="200" r="50" fill="#2d2d2d"/>
                <circle cx="200" cy="200" r="45" fill="#1a1a1a"/>
                <circle cx="200" cy="200" r="25" fill="#0a1628"/>
                <circle cx="200" cy="200" r="23" fill="none" stroke="#c0c0c0" stroke-width="1"/>
                <path d="M200 177 A23 23 0 0 1 223 200 L200 200 Z" fill="#3b82f6"/>
                <path d="M223 200 A23 23 0 0 1 200 223 L200 200 Z" fill="#ffffff"/>
                <path d="M200 223 A23 23 0 0 1 177 200 L200 200 Z" fill="#3b82f6"/>
                <path d="M177 200 A23 23 0 0 1 200 177 L200 200 Z" fill="#ffffff"/>
                <circle cx="200" cy="200" r="23" fill="none" stroke="#c0c0c0" stroke-width="1.5"/>
                <path d="M200 145 L200 50" stroke="#1a1a1a" stroke-width="22" stroke-linecap="round"/>
                <path d="M200 145 L200 50" stroke="#2d2d2d" stroke-width="18" stroke-linecap="round"/>
                <path d="M155 220 L75 280" stroke="#1a1a1a" stroke-width="22" stroke-linecap="round"/>
                <path d="M155 220 L75 280" stroke="#2d2d2d" stroke-width="18" stroke-linecap="round"/>
                <path d="M245 220 L325 280" stroke="#1a1a1a" stroke-width="22" stroke-linecap="round"/>
                <path d="M245 220 L325 280" stroke="#2d2d2d" stroke-width="18" stroke-linecap="round"/>
                <circle cx="200" cy="30" r="12" fill="#0f0f0f"/>
                <circle cx="75" cy="280" r="12" fill="#0f0f0f"/>
                <circle cx="325" cy="280" r="12" fill="#0f0f0f"/>
            </svg>
            <svg class="driver-hands" viewBox="0 0 1200 500" preserveAspectRatio="xMidYMax slice" fill="none">
                <path d="M0 500 L0 350 Q50 320 120 310 L200 300 Q250 295 280 280 L320 260 Q340 250 350 240 L380 220 Q390 215 395 210 L400 200 Q405 195 410 195 L420 200 Q425 210 420 220 L410 240 Q400 260 380 280 L340 310 Q300 330 250 340 L150 360 Q80 370 0 380 Z" fill="#1a1a1a"/>
                <path d="M380 220 Q390 200 410 190 Q430 185 450 190 Q470 200 480 220 Q490 240 485 260 Q480 275 470 285 Q460 290 450 285 Q440 275 435 260 Q430 245 425 235 Q420 230 415 232 Q410 240 405 250 Q400 260 395 265 Q385 270 380 260 Q375 245 378 230 Z" fill="#d4a574"/>
                <path d="M450 190 Q460 180 470 175 Q480 175 485 185 Q488 195 485 205 Q480 210 475 208 Q470 200 465 195 Z" fill="#c9956a"/>
                <path d="M465 185 Q475 178 482 178 Q488 182 488 192 Q486 200 480 202 Q474 200 470 193 Z" fill="#c9956a"/>
                <path d="M1200 500 L1200 350 Q1150 320 1080 310 L1000 300 Q950 295 920 280 L880 260 Q860 250 850 240 L820 220 Q810 215 805 210 L800 200 Q795 195 790 195 L780 200 Q775 210 780 220 L790 240 Q800 260 820 280 L860 310 Q900 330 950 340 L1050 360 Q1120 370 1200 380 Z" fill="#1a1a1a"/>
                <path d="M820 220 Q810 200 790 190 Q770 185 750 190 Q730 200 720 220 Q710 240 715 260 Q720 275 730 285 Q740 290 750 285 Q760 275 765 260 Q770 245 775 235 Q780 230 785 232 Q790 240 795 250 Q800 260 805 265 Q815 270 820 260 Q825 245 822 230 Z" fill="#d4a574"/>
                <path d="M750 190 Q740 180 730 175 Q720 175 715 185 Q712 195 715 205 Q720 210 725 208 Q730 200 735 195 Z" fill="#c9956a"/>
                <path d="M735 185 Q725 178 718 178 Q712 182 712 192 Q714 200 720 202 Q726 200 730 193 Z" fill="#c9956a"/>
                <path d="M280 280 L320 260 L325 270 L285 290 Z" fill="#f5f5f5"/>
                <path d="M920 280 L880 260 L875 270 L915 290 Z" fill="#f5f5f5"/>
            </svg>
            <div class="dashboard-silhouette"></div>
            <svg class="absolute bottom-0 left-0 right-0 h-32 w-full" viewBox="0 0 1200 150" preserveAspectRatio="xMidYMax slice" fill="none">
                <rect x="450" y="80" width="300" height="70" rx="8" fill="#0a0a0a" opacity="0.9"/>
                <rect x="200" y="90" width="120" height="40" rx="4" fill="#1a1a1a" opacity="0.8"/>
                <rect x="880" y="90" width="120" height="40" rx="4" fill="#1a1a1a" opacity="0.8"/>
                <line x1="210" y1="100" x2="310" y2="100" stroke="#0a0a0a" stroke-width="2"/>
                <line x1="210" y1="110" x2="310" y2="110" stroke="#0a0a0a" stroke-width="2"/>
                <line x1="210" y1="120" x2="310" y2="120" stroke="#0a0a0a" stroke-width="2"/>
                <line x1="890" y1="100" x2="990" y2="100" stroke="#0a0a0a" stroke-width="2"/>
                <line x1="890" y1="110" x2="990" y2="110" stroke="#0a0a0a" stroke-width="2"/>
                <line x1="890" y1="120" x2="990" y2="120" stroke="#0a0a0a" stroke-width="2"/>
                <rect x="500" y="90" width="200" height="50" rx="4" fill="#1e3a5f" opacity="0.3"/>
            </svg>
            <div class="absolute inset-0" style="background: radial-gradient(ellipse at center, transparent 40%, rgba(0,0,0,0.6) 100%);"></div>
        </div>

        <div class="absolute inset-0 bg-gradient-to-r from-navy-950/85 via-navy-950/60 to-navy-950/30 z-[1]"></div>

        <div class="max-w-7xl mx-auto px-4 py-20 relative z-10 w-full">
            <div class="grid lg:grid-cols-2 gap-12 items-center">
                <div class="animate-fade-in">
                    <div class="mb-4">
                        <span class="font-display text-2xl md:text-3xl text-damasco-600 tracking-wider">ST TRANSAE CHILE</span>
                    </div>

                    <h1 class="hero-title font-display text-6xl md:text-7xl lg:text-8xl font-bold text-white leading-[0.95] mb-6">
                        TRANSPORTE PRIVADO<br>
                        <span class="text-gradient">EJECUTIVO</span>
