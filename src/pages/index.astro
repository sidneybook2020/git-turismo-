---
import '../styles/global.css';

const siteTitle = "ST TRANSAE | Transporte Privado Ejecutivo Chile";
const siteDescription = "Servicio de transporte privado ejecutivo en Santiago de Chile. Traslados aeropuerto, tours vitivinícolas, eventos. Disponible 24/7.";
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{siteTitle}</title>
    <meta name="description" content={siteDescription}>
    
    <!-- Carga de fuentes (idéntica al original) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
</head>
<body class="bg-white text-gray-900 overflow-x-hidden">

<!-- INICIO TOP BAR -->
    <div class="bg-navy-950 text-white text-xs py-2 px-4">
        <div class="max-w-7xl mx-auto flex justify-between items-center">
            <div class="flex items-center gap-4">
                <span class="flex items-center gap-1"><span class="w-2 h-2 bg-green-400 rounded-full pulse-dot"></span> DISPONIBLE 24/7</span>
                <span class="hidden md:inline">•</span>
                <span class="hidden md:inline">ENGLISH SPOKEN</span>
                <span class="hidden md:inline">•</span>
                <span class="hidden md:inline">LICENCIA M.T.T. #14457</span>
            </div>
            <div class="flex items-center gap-3">
                <button class="text-gray-400 hover:text-white transition">ES</button>
                <span class="text-gray-600">|</span>
                <button class="text-white font-medium">EN</button>
            </div>
        </div>
    </div>
<!-- FIN TOP BAR -->

<!-- INICIO HEADER / NAVEGACIÓN -->
    <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-gray-100 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 py-4">
            <div class="flex justify-between items-center">
                <div class="flex items-center gap-3">
                    <a href="#home" class="flex items-center gap-3 group">
                        <div class="w-12 h-12 rounded-full damasco-gradient flex items-center justify-center shadow-lg group-hover:scale-105 transition">
                            <span class="text-white font-bold text-lg font-display">ST</span>
                        </div>
                        <div>
                            <h1 class="text-xl font-bold text-navy-950 tracking-tight font-display">ST TRANSAE</h1>
                            <p class="text-xs text-gray-500 -mt-1">Private Transport Chile</p>
                        </div>
                    </a>
                </div>                
                <nav class="hidden lg:flex items-center gap-8">
                    <a href="#servicios" class="nav-link text-sm font-medium text-gray-700 hover:text-damasco-800 transition">SERVICIOS</a>
                    <a href="#vehiculo" class="nav-link text-sm font-medium text-gray-700 hover:text-damasco-800 transition">VEHÍCULO</a>
                    <a href="#info" class="nav-link text-sm font-medium text-gray-700 hover:text-damasco-800 transition">INFO VIAJERO</a>
                    <a href="#faq" class="nav-link text-sm font-medium text-gray-700 hover:text-damasco-800 transition">FAQ</a>
                    <a href="#pagos" class="nav-link text-sm font-medium text-gray-700 hover:text-damasco-800 transition">PAGOS</a>
                    <a href="#contacto" class="nav-link text-sm font-medium text-gray-700 hover:text-damasco-800 transition">CONTACTO</a>
                </nav>
                <div class="flex items-center gap-4">
                    <a href="#contacto" class="hidden md:inline-flex btn-primary text-white px-6 py-2.5 rounded-full text-sm font-semibold">RESERVAR</a>
                    <button class="lg:hidden text-gray-700" onclick="toggleMenu()">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
                    </button>
                </div>
            </div>
        </div>
        <div id="mobileMenu" class="hidden lg:hidden bg-white border-t border-gray-100">
            <div class="px-4 py-4 space-y-3">
                <a href="#servicios" class="block text-gray-700 py-2 font-medium" onclick="toggleMenu()">SERVICIOS</a>
                <a href="#vehiculo" class="block text-gray-700 py-2 font-medium" onclick="toggleMenu()">VEHÍCULO</a>
                <a href="#info" class="block text-gray-700 py-2 font-medium" onclick="toggleMenu()">INFO VIAJERO</a>
                <a href="#faq" class="block text-gray-700 py-2 font-medium" onclick="toggleMenu()">PREGUNTAS FRECUENTES</a>
                <a href="#pagos" class="block text-gray-700 py-2 font-medium" onclick="toggleMenu()">MÉTODOS DE PAGO</a>
                <a href="#contacto" class="block text-gray-700 py-2 font-medium" onclick="toggleMenu()">CONTACTO</a>
                <a href="#contacto" class="block btn-primary text-white text-center py-3 rounded-full font-semibold mt-4" onclick="toggleMenu()">RESERVAR AHORA</a>
            </div>
        </div>
    </header>
<!-- FIN HEADER / NAVEGACIÓN -->

<!-- INICIO SECCIÓN HERO -->
    <section id="home" class="relative min-h-screen flex items-center overflow-hidden">
        <div class="hero-driver-bg" id="parallaxBg">
            <img src="/portada-transae.jpg" alt="Fondo ST Transae" class="absolute inset-0 w-full h-full object-cover" style="will-change: transform;"/>
            <div class="absolute inset-0 bg-gradient-to-r from-navy-950/85 via-navy-950/60 to-navy-950/30 z-[1]"></div>
            <div class="absolute inset-0 bg-gradient-to-t from-navy-950/80 via-transparent to-transparent z-[1]"></div>
        </div>
        <div class="max-w-7xl mx-auto px-4 py-20 relative z-10 w-full">
            <div class="grid lg:grid-cols-2 gap-12 items-center">
                <div class="animate-fade-in">
                    <div class="mb-4">
                        <span class="font-display text-2xl md:text-3xl text-damasco-600 tracking-wider">ST TRANSAE CHILE</span>
                    </div>
                    <h1 class="hero-title font-display text-6xl md:text-7xl lg:text-8xl font-bold text-white leading-[0.95] mb-6">
                        TRANSPORTE PRIVADO<br>
                        <span class="text-gradient">EJECUTIVO</span>
                    </h1>
                    <p class="text-gray-300 text-lg md:text-xl mb-8 max-w-xl leading-relaxed">
                        Traslados en confianza y absoluta discreción en Santiago de Chile y principales destinos vitivinícolas, cordillera y costa central.
                    </p>
                    <div class="flex flex-wrap gap-4 mb-10">
                        <a href="https://wa.me/56989625825" class="btn-damasco px-8 py-3.5 rounded-full font-semibold flex items-center gap-2 text-sm uppercase tracking-wide">
                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
                            COTIZAR VÍA WHATSAPP
                        </a>
                        <a href="#contacto" class="btn-outline-white px-8 py-3.5 rounded-full font-semibold text-sm uppercase tracking-wide">RESERVAR</a>
                    </div>
                    <div class="grid grid-cols-3 gap-4 max-w-lg">
                        <div class="indicator-card glass-card rounded-2xl p-4 text-center">
                            <div class="font-display text-4xl text-white mb-1">100%</div>
                            <div class="text-xs text-gray-400 uppercase tracking-wider">Puntualidad</div>
                        </div>
                        <div class="indicator-card glass-card rounded-2xl p-4 text-center">
                            <div class="font-display text-4xl text-white mb-1">5 PAX</div>
                            <div class="text-xs text-gray-400 uppercase tracking-wider">Capacidad</div>
                        </div>
                        <div class="indicator-card glass-card rounded-2xl p-4 text-center">
                            <div class="font-display text-4xl text-white mb-1">24/7</div>
                            <div class="text-xs text-gray-400 uppercase tracking-wider">Atención</div>
                        </div>
                    </div>
                </div>
                <div id="cotizar" class="animate-slide-up relative">
                    <div class="absolute -top-4 right-4 md:-top-6 md:right-8 z-20">
                        <div class="bg-navy-950/70 backdrop-blur-md border border-white/20 rounded-full px-4 py-2 flex items-center gap-2 shadow-xl">
                            <svg class="w-4 h-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                            <span class="text-white text-sm font-semibold">5.0</span>
                            <span class="text-gray-300 text-xs">(280+ reseñas)</span>
                        </div>
                    </div>
                    <div class="glass-white rounded-3xl shadow-2xl p-8 max-w-md ml-auto">
                        <div class="flex items-center gap-3 mb-6">
                            <div class="w-10 h-10 rounded-full damasco-gradient flex items-center justify-center">
                                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                            </div>
                            <h2 class="text-2xl font-bold text-gray-900">Cotiza Tu Itinerario</h2>
                        </div>
                        <form class="space-y-4" onsubmit="handleQuote(event)">
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Tipo de Traslado</label>
                                <select class="w-full input-field rounded-xl px-4 py-3 bg-gray-50">
                                    <option>Traslado SCL → Destino</option>
                                    <option>Destino → Aeropuerto SCL</option>
                                    <option>Tour Vitivinícola</option>
                                    <option>Tour Cordillera / Ski</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Origen</label>
                                <input type="text" placeholder="Ej: Aeropuerto SCL" class="w-full input-field rounded-xl px-4 py-3 bg-gray-50">
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Destino</label>
                                <input type="text" placeholder="Ej: Hotel en Las Condes" class="w-full input-field rounded-xl px-4 py-3 bg-gray-50">
                            </div>
                            <div class="grid grid-cols-2 gap-3">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">Fecha</label>
                                    <input type="date" class="w-full input-field rounded-xl px-4 py-3 bg-gray-50">
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">Hora</label>
                                    <input type="time" class="w-full input-field rounded-xl px-4 py-3 bg-gray-50">
                                </div>
                            </div>
                            <button type="submit" class="w-full btn-damasco py-4 rounded-xl font-semibold flex items-center justify-center gap-2 uppercase tracking-wide">
                                CONTINUAR Y COTIZAR VÍA WHATSAPP
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>
<!-- FIN SECCIÓN HERO -->

    <div class="section-divider"></div>

<!-- INICIO SECCIÓN VEHÍCULO -->
    <section id="vehiculo" class="py-20 bg-gradient-to-b from-gray-50 to-white">
        <div class="max-w-7xl mx-auto px-4">
            <div class="text-center mb-16 scroll-reveal">
                <span class="font-display text-damasco-600 text-sm md:text-base uppercase tracking-[0.15em] font-semibold block mb-3">Sedán Ejecutivo ST Transae</span>
                <h2 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-navy-950 tracking-tight leading-tight">MÁXIMA COMODIDAD Y<br>SEGURIDAD A BORDO</h2>
                <p class="text-gray-600 max-w-3xl mx-auto text-lg mt-4">Cada trayecto está concebido como una extensión de su oficina o hogar; con un conductor profesional bilingüe entrenado con total discreción y cortesía.</p>
            </div>
            <div class="scroll-reveal mb-16">
                <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-0">
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 md:gap-6 items-stretch">
                        <div class="relative rounded-2xl md:rounded-3xl overflow-hidden shadow-2xl min-h-[300px] sm:min-h-[380px] md:min-h-[450px] lg:min-h-[520px] group">
                            <div class="absolute inset-0 bg-gradient-to-t from-black/30 via-transparent to-black/10 z-10 pointer-events-none"></div>
                            <div class="absolute inset-0 bg-gradient-to-br from-white/0 via-white/0 to-white/20 opacity-0 group-hover:opacity-100 transition-opacity duration-700 z-10 pointer-events-none"></div>
                            <img src="/range-rover-blanco.jpg" alt="Range Rover Sport Ejecutivo ST Transae" class="absolute inset-0 w-full h-full object-cover object-center transition-transform duration-[1200ms] ease-out group-hover:scale-[1.05]" style="transform-origin: center center;" />
                            <div class="absolute bottom-0 left-0 right-0 h-24 md:h-32 bg-gradient-to-t from-black/40 to-transparent z-10 pointer-events-none"></div>
                            <div class="absolute top-3 left-3 md:top-6 md:left-6 z-20 bg-white/95 backdrop-blur-sm rounded-full px-3 py-1.5 md:px-5 md:py-2 shadow-lg">
                                <span class="font-display text-xs md:text-sm text-navy-950 tracking-wider uppercase">Range Rover Sport</span>
                            </div>
                        </div>
                        <div class="p-5 sm:p-6 md:p-8 lg:p-12 flex flex-col justify-center bg-white rounded-2xl md:rounded-3xl shadow-xl border border-gray-100">
                            <div class="mb-2">
                                <span class="text-damasco-600 font-display text-xs sm:text-sm uppercase tracking-[0.2em] font-semibold">Experiencia de Primera Clase</span>
                                <div class="w-10 md:w-12 h-1 bg-damasco-600 mt-2 md:mt-3 rounded-full"></div>
                            </div>
                            <h3 class="font-display text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold text-navy-950 mt-3 md:mt-4 mb-6 md:mb-10 leading-tight">Equipamiento y confort<br>de primera clase</h3>
                            <div class="space-y-5 md:space-y-8">
                                <div class="flex items-start gap-3 md:gap-5 group">
                                    <div class="flex-shrink-0 w-11 h-11 md:w-14 md:h-14 rounded-lg md:rounded-xl bg-damasco-50 flex items-center justify-center group-hover:bg-damasco-600 transition-colors duration-300">
                                        <svg class="w-5 h-5 md:w-7 md:h-7 text-damasco-600 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
                                    </div>
                                    <div>
                                        <h4 class="font-display text-base sm:text-lg md:text-xl font-bold text-navy-950 mb-0.5 md:mb-1">Confort para 4–5 Pasajeros</h4>
                                        <p class="text-gray-600 text-xs sm:text-sm leading-relaxed">Asientos de cuero ergonómicos y amplio espacio.</p>
                                    </div>
                                </div>
                                <div class="flex items-start gap-3 md:gap-5 group">
                                    <div class="flex-shrink-0 w-11 h-11 md:w-14 md:h-14 rounded-lg md:rounded-xl bg-damasco-50 flex items-center justify-center group-hover:bg-damasco-600 transition-colors duration-300">
                                        <svg class="w-5 h-5 md:w-7 md:h-7 text-damasco-600 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
                                    </div>
                                    <div>
                                        <h4 class="font-display text-base sm:text-lg md:text-xl font-bold text-navy-950 mb-0.5 md:mb-1">Equipaje seguro & sanitizado</h4>
                                        <p class="text-gray-600 text-xs sm:text-sm leading-relaxed">Capacidad para 4 maletas de 23 kg con desinfección diaria.</p>
                                    </div>
                                </div>
                                <div class="flex items-start gap-3 md:gap-5 group">
                                    <div class="flex-shrink-0 w-11 h-11 md:w-14 md:h-14 rounded-lg md:rounded-xl bg-damasco-50 flex items-center justify-center group-hover:bg-damasco-600 transition-colors duration-300">
                                        <svg class="w-5 h-5 md:w-7 md:h-7 text-damasco-600 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.141 0M1.394 9.393c5.857-5.857 15.355-5.857 21.213 0"/></svg>
                                    </div>
                                    <div>
                                        <h4 class="font-display text-base sm:text-lg md:text-xl font-bold text-navy-950 mb-0.5 md:mb-1">WiFi 5G & Conectividad 24/7</h4>
                                        <p class="text-gray-600 text-xs sm:text-sm leading-relaxed">Cargadores multi-dispositivo y conexión continua.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 scroll-reveal">
                <div class="unified-hover-card bg-white rounded-2xl p-8 border border-gray-100 shadow-lg text-center">
                    <div class="feature-icon w-16 h-16 rounded-2xl mx-auto mb-4 flex items-center justify-center">
                        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
                    </div>
                    <div class="font-display text-4xl text-navy-950 mb-2">5 PAX</div>
                    <p class="text-gray-600 text-sm">Asientos ergonómicos y amplio maletero</p>
                </div>
                <div class="unified-hover-card bg-white rounded-2xl p-8 border border-gray-100 shadow-lg text-center">
                    <div class="feature-icon w-16 h-16 rounded-2xl mx-auto mb-4 flex items-center justify-center">
                        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.141 0M1.394 9.393c5.857-5.857 15.355-5.857 21.213 0"/></svg>
                    </div>
                    <div class="font-display text-4xl text-navy-950 mb-2">5G WIFI</div>
                    <p class="text-gray-600 text-sm">Internet satelital de alta velocidad gratuito</p>
                </div>
                <div class="unified-hover-card bg-white rounded-2xl p-8 border border-gray-100 shadow-lg text-center">
                    <div class="feature-icon w-16 h-16 rounded-2xl mx-auto mb-4 flex items-center justify-center">
                        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                    </div>
                    <div class="font-display text-4xl text-navy-950 mb-2">100%</div>
                    <p class="text-gray-600 text-sm">Póliza de responsabilidad civil total</p>
                </div>
